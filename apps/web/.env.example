# Copy to .env.local (or run `pnpm setup:env`, which generates random secrets).

# PostgreSQL connection. `pnpm db:start` runs a local Postgres on this URL.
DATABASE_URL=postgres://tokenrank:tokenrank@127.0.0.1:54329/tokenrank

# Public origin of the site (WebAuthn origin, links in emails and device login).
APP_ORIGIN=http://localhost:3000
# WebAuthn relying-party id (defaults to APP_ORIGIN's hostname).
WEBAUTHN_RP_ID=localhost

# Root secret for HMACs: org fingerprints, recovery-email lookup, signed cookies.
# Required in production. 32+ random bytes.
SERVER_SECRET=

# Key-encryption key for envelope encryption of cloud-sync credentials.
# Base64 of exactly 32 random bytes. Required in production. Keep it outside the database
# (secret manager / KMS). Rotating it requires re-wrapping user_keys.
MASTER_KEY=

# Bearer secret for /api/internal/cron (serverless schedulers).
CRON_SECRET=

# Comma-separated usernames who may review flagged usage at /admin/review.
ADMIN_USERNAMES=

# Optional: SMTP for recovery emails. Without it, dev prints links to the console.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=TokenRank <no-reply@example.com>

# Optional tuning
# ACTIVE_DAY_MIN_TOKENS=1                 # a day is "active" at >= this many tokens
# SANITY_LIMITS_JSON={"claude_code":5000000000}
# IMAGE_SANITY_LIMIT=100000
# REFRESH_INTERVAL_MS=120000              # leaderboard materialized-view refresh
# RUN_JOBS_IN_PROCESS=1                   # run jobs inside `next start` (default: on in dev, off in prod)
# TRUST_PROXY=1                           # use X-Forwarded-For for rate limiting (only behind your proxy)
# LOG_REQUESTS=1                          # log route/method/status/duration for every request
